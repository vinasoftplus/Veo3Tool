{$DOMAIN} {
  encode gzip

  # Admin dashboard tại /admin-manage
  handle /admin-manage* {
    uri strip_prefix /admin-manage
    reverse_proxy admin-dashboard:3000 {
      header_down Location ^/(.*)$ /admin-manage/$1
    }
  }

  # API license server (public endpoint cho tool)
  handle /api/* {
    reverse_proxy license-server:8080 {
      header_up X-Forwarded-For {http.request.remote.host}
      header_up X-Real-IP {http.request.remote.host}
    }
  }

  # Admin API routes (JWT protected, dùng bởi dashboard)
  handle /admin/* {
    reverse_proxy license-server:8080 {
      header_up X-Forwarded-For {http.request.remote.host}
      header_up X-Real-IP {http.request.remote.host}
    }
  }

  # EXE downloads (static file server)
  handle /downloads/* {
    root * /srv/downloads
    uri strip_prefix /downloads
    file_server
  }

  # Health check
  handle /health {
    reverse_proxy license-server:8080
  }
}
