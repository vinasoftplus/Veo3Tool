# Database
DB_USER=licenseuser
DB_PASS=changeme_strong_password_here

# Crypto — generate with: openssl genpkey -algorithm ed25519 | base64 -w0
ED25519_PRIVATE_KEY_B64=

# Admin auth
JWT_SECRET=                # 64 random hex chars: openssl rand -hex 32
TOTP_ENCRYPT_KEY=          # 32 random hex chars: openssl rand -hex 16

# Domain (used by Caddy)
DOMAIN=license.yourdomain.com

# Backblaze B2 (optional backup)
B2_BUCKET=license-backups
B2_KEY_ID=
B2_APP_KEY=

# Server port
PORT=8080
