{
  "manifest_version": 3,
  "name": "Google Cookie Extractor",
  "version": "1.0",
  "description": "Extract cookies from Google",
  "permissions": [
    "cookies",
    "activeTab",
    "storage",
    "tabs",
    "webRequest"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Google Cookie Extractor"
  }
}