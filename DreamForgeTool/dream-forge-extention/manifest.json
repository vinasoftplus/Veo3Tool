{
  "manifest_version": 3,
  "name": "Dream Forge Extension",
  "version": "1.0.3",
  "description": "Cầu nối giữa ứng dụng Dream Forge và Google Labs, tự động hóa quy trình tạo ảnh và video AI hàng loạt trên máy tính cá nhân.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "scripting",
    "tabs",
    "alarms",
    "webRequest",
    "webRequestAuthProvider",
    "storage",
    "proxy"
  ],
  "host_permissions": [
    "https://labs.google/*",
    "https://*.labs.google/*",
    "https://*.googleapis.com/*",
    "https://aisandbox-pa.googleapis.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://labs.google/*"
      ],
      "js": [
        "fingerprint-protection.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://labs.google/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
